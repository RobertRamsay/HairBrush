+        if (!Near(a.y, b.y)) return false;
+        if (!Near(a.z, b.z)) return false;
+        if (!Near(a.curlFrequency, b.curlFrequency)) return false;
+        if (!Near(a.curlDiameter, b.curlDiameter)) return false;
