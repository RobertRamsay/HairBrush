+    // Twenty-four flat steps, black at the left through to white at the right. Anchored by
+    // fraction rather than sized in pixels, so the ramp fills whatever width the bar gives it.
+    static void BuildRampSegments(Transform parent)
+    {
+        const int steps = 24;
+        for (int i = 0; i < steps; i++)
+        {
+            float tone = i / (float)(steps - 1);
+            GameObject segment = new GameObject("Step" + i, typeof(RectTransform), typeof(Image));
+            segment.transform.SetParent(parent, false);
+            RectTransform rect = segment.GetComponent<RectTransform>();
+            rect.anchorMin = new Vector2(i / (float)steps, 0f);
+            rect.anchorMax = new Vector2((i + 1) / (float)steps, 1f);
+            rect.offsetMin = Vector2.zero;
+            rect.offsetMax = Vector2.zero;
+            Image image = segment.GetComponent<Image>();
+            image.color = new Color(tone, tone, tone, 1f);
+            // The slider needs the BACKGROUND to take the click, not twenty-four children
+            // intercepting it one strip at a time.
+            image.raycastTarget = false;
+        }
+    }
+
