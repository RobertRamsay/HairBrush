@@ -22,6 +22,9 @@ public class ClumperControlsScrollFix : MonoBehaviour
     // Fallback used only for the single frame before the utility rows can be measured.
     private const float FallbackTopInset = 101f;
 
+    // Breathing room above the GUIDE n / CLUMPER n title, inside the host. See BuildHost.
+    private const int HeaderGap = 22;
+
     [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
     static void Spawn()
     {
@@ -125,13 +128,28 @@ public class ClumperControlsScrollFix : MonoBehaviour
 
         VerticalLayoutGroup panelLayout = panel.GetComponent<VerticalLayoutGroup>();
         if (panelLayout != null && visibleRows > 0)
-            inset += panelLayout.spacing * visibleRows + panelLayout.padding.top;
+            inset += panelLayout.spacing * visibleRows + BaseTopPadding(panel, panelLayout);
 
         if (inset <= 0f) inset = FallbackTopInset;
 
         hostRT.offsetMax = new Vector2(hostRT.offsetMax.x, -inset);
     }
 
+    // The panel's own top padding is NOT a constant: GroomingPanelWheelScroll writes the live
+    // wheel offset into it, so reading it raw gives base minus however far the panel is scrolled.
+    // Taken raw, selecting a guide while the groom panel was scrolled down shrank this inset by
+    // the scroll offset and put the host up under the SAVE PROJ row for the first few frames -
+    // until the scroll authority's next clamp noticed the panel now has no layout children left,
+    // pulled the offset back to zero and restored the padding underneath it. Brief, but it is the
+    // first thing you see on selecting a guide. Ask for the baseline instead, exactly as
+    // GroomingPanelFrozenHeaderAuthority does.
+    static float BaseTopPadding(Transform panel, VerticalLayoutGroup layout)
+    {
+        GroomingPanelWheelScroll wheel = panel.GetComponent<GroomingPanelWheelScroll>();
+        if (wheel != null && wheel.HasBasePadding) return wheel.BaseTopPadding;
+        return layout.padding.top;
+    }
+
     static float MeasuredHeight(RectTransform rect)
     {
         if (rect == null) return 0f;
@@ -264,7 +282,18 @@ public class ClumperControlsScrollFix : MonoBehaviour
         content.sizeDelta = Vector2.zero;
 
         VerticalLayoutGroup outerLayout = contentGO.GetComponent<VerticalLayoutGroup>();
-        outerLayout.padding = new RectOffset(2, 2, 2, 12);
+
+        // HeaderGap on top rather than the 2 that used to be here. The host's top edge sits just
+        // under TopControlsRow, and with only 2px of padding inside it the GUIDE n / CLUMPER n
+        // title landed about twelve pixels below the RESET button - close enough to read as part
+        // of that row rather than as the start of its own panel.
+        //
+        // Here rather than on the host's own inset, because the inset is what keeps the box
+        // clear of the buttons above; growing that instead would open a strip of bare panel
+        // background above the box. And here rather than on the two managers' own layout groups,
+        // because both of their control roots are reparented into this one Content and a value
+        // set in two files is a value that drifts apart.
+        outerLayout.padding = new RectOffset(2, 2, HeaderGap, 12);
         outerLayout.spacing = 0f;
         outerLayout.childControlWidth = true;
         outerLayout.childControlHeight = false;
