-using System.Reflection;
-using UnityEngine;
-using UnityEngine.Events;
-using UnityEngine.UI;
-
-// Adds a "Length Fine" slider (0.0001..0.1) directly under the Length block, shown only while
-// the current length is inside that range. The main Length slider's full 0..0.5 sweep gives
-// short hair only a few pixels of travel; this dedicates a whole slider's width to that
-// bottom band for fine control. It never owns state: changes are forwarded through the main
-// Length_Slider's normal value pipeline (variance rebase, group updates, root authority all
-// see an ordinary Length slider change), and the fine slider itself just mirrors
-// viewer.currentLength every frame - so save/load, resets, and POST-exit restores that only
-// know about Length_Slider stay correct without changes.
-[DefaultExecutionOrder(9540)]
-public class LengthFineControlAuthority : MonoBehaviour
-{
-    private const float FineMax = .1f;
-    private const float FineMin = .0001f;
-
-    private ModelViewer viewer;
-    private MethodInfo createSliderMethod;
-    private GameObject fineRow;
-    private Slider fineSlider;
-    private Slider mainLengthSlider;
-    private GameObject boundPanel;
-    private float nextScan;
-
-    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
-    static void Spawn()
-    {
-        if (FindFirstObjectByType<LengthFineControlAuthority>() != null) return;
-        GameObject go = new GameObject("LengthFineControlAuthority");
-        DontDestroyOnLoad(go);
-        go.AddComponent<LengthFineControlAuthority>();
-    }
-
-    void LateUpdate()
-    {
-        Resolve();
-        if (viewer == null || viewer.groomingSliderPanelGO == null) return;
-
-        if (boundPanel != viewer.groomingSliderPanelGO)
-        {
-            boundPanel = viewer.groomingSliderPanelGO;
-            fineRow = null;
-            fineSlider = null;
-            mainLengthSlider = null;
-        }
-
-        if (Time.unscaledTime >= nextScan)
-        {
-            nextScan = Time.unscaledTime + .15f;
-            EnsureFineRow();
-        }
-
-        if (fineRow == null || fineSlider == null) return;
-
-        bool visible = viewer.currentLength < FineMax;
-        if (fineRow.activeSelf != visible) fineRow.SetActive(visible);
-        if (visible && !Mathf.Approximately(fineSlider.value, viewer.currentLength))
-            fineSlider.SetValueWithoutNotify(Mathf.Clamp(viewer.currentLength, FineMin, FineMax));
-    }
-
-    void EnsureFineRow()
-    {
-        Transform panel = boundPanel.transform;
-        if (fineRow == null)
-        {
-            Transform existing = panel.Find("Length Fine_Row");
-            if (existing != null)
-            {
-                fineRow = existing.gameObject;
-                fineSlider = fineRow.GetComponentInChildren<Slider>(true);
-            }
-        }
-
-        if (fineRow == null && createSliderMethod != null)
-        {
-            UnityAction<float> onFine = ForwardToMainSlider;
-            object[] args = { panel, "Length Fine", FineMin, FineMax, viewer.currentLength, onFine, null, 38f, 16 };
-            fineRow = createSliderMethod.Invoke(viewer, args) as GameObject;
-            fineSlider = args[6] as Slider;
-        }
-
-        if (fineRow == null) return;
-
-        // Sits after the Length block's own divider so it reads as part of that group. The
-        // divider is generated by GroomVarianceController, so it may not exist yet on the
-        // first few scans - fall back to directly after Length_Row until it appears.
-        Transform anchor = panel.Find("Length_VarianceDivider") ?? panel.Find("Length_Row");
-        if (anchor != null)
-        {
-            int desired = Mathf.Min(anchor.GetSiblingIndex() + 1, panel.childCount - 1);
-            if (fineRow.transform.GetSiblingIndex() != desired)
-                fineRow.transform.SetSiblingIndex(desired);
-        }
-    }
-
-    // Routing through the main slider (with notification) means every listener attached to
-    // it - group updates, selection rebasing, label refresh - fires exactly as if the person
-    // had dragged the main slider itself, just with finer input granularity.
-    void ForwardToMainSlider(float value)
-    {
-        if (mainLengthSlider == null && boundPanel != null)
-        {
-            Transform main = boundPanel.transform.Find("Length_Row");
-            if (main != null) mainLengthSlider = main.GetComponentInChildren<Slider>(true);
-        }
-        if (mainLengthSlider != null)
-            mainLengthSlider.value = Mathf.Clamp(value, FineMin, FineMax);
-    }
-
-    void Resolve()
-    {
-        if (viewer != null) return;
-        viewer = FindFirstObjectByType<ModelViewer>();
-        if (viewer != null)
-            createSliderMethod = typeof(ModelViewer).GetMethod("CreateSliderUI", BindingFlags.Instance | BindingFlags.NonPublic);
-    }
-}
