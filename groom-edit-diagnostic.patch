+using System.Collections.Generic;
+using System.Reflection;
+using UnityEngine;
+
+// TEMPORARY DIAGNOSTIC - delete this file once the dead-slider question is settled.
+//
+// Question it answers, in a single Bend drag: when a group-level slider moves and nothing
+// happens on screen, WHERE does the edit stop?
+//
+//   A. it never reaches the cards        -> cardsChanged = 0
+//   B. it reaches them but the mesh is held -> cardsChanged > 0, sigChanged = 0
+//   C. mesh rebuilds but the clumper overwrites it -> sigChanged > 0, override stays 1
+//
+// Those three need completely different fixes, and guessing between them from the source has
+// already been wrong twice. Watch the Console while dragging Bend.
+[DefaultExecutionOrder(9999)]
+public class GroomEditDiagnostics : MonoBehaviour
+{
+    private ModelViewer viewer;
+    private PostAffectorManager posts;
+
+    private FieldInfo hasSelField;
+    private FieldInfo selModeField;
+    private FieldInfo relModeField;
+
+    private bool primed;
+    private float lastBend;
+    private int reportFrames;
+
+    private readonly Dictionary<int, float> cardBend = new Dictionary<int, float>();
+    private readonly Dictionary<int, int> cardSig = new Dictionary<int, int>();
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+    static void Spawn()
+    {
+        if (FindFirstObjectByType<GroomEditDiagnostics>() != null) return;
+        GameObject go = new GameObject(nameof(GroomEditDiagnostics));
+        DontDestroyOnLoad(go);
+        go.AddComponent<GroomEditDiagnostics>();
+    }
+
+    void Resolve()
+    {
+        if (viewer == null)
+        {
+            viewer = FindFirstObjectByType<ModelViewer>();
+            if (viewer != null)
+            {
+                BindingFlags f = BindingFlags.Instance | BindingFlags.NonPublic;
+                hasSelField = typeof(ModelViewer).GetField("hasSelectionHotspot", f);
+                selModeField = typeof(ModelViewer).GetField("isSelectionMode", f);
+                relModeField = typeof(ModelViewer).GetField("isRelativeMode", f);
+            }
+        }
+        if (posts == null) posts = FindFirstObjectByType<PostAffectorManager>();
+    }
+
+    bool Flag(FieldInfo f)
+    {
+        return f != null && viewer != null && f.GetValue(viewer) is bool b && b;
+    }
+
+    void Snapshot(int groupId)
+    {
+        cardBend.Clear();
+        cardSig.Clear();
+        foreach (HairCard card in FindObjectsByType<HairCard>(FindObjectsSortMode.None))
+        {
+            if (card == null || card.groupId != groupId) continue;
+            int id = card.GetInstanceID();
+            cardBend[id] = card.bendAngle;
+            cardSig[id] = card.GetGeneratedMeshSignature();
+        }
+    }
+
+    void LateUpdate()
+    {
+        Resolve();
+        if (viewer == null) return;
+
+        int gid = viewer.currentGroupId;
+
+        if (!primed)
+        {
+            primed = true;
+            lastBend = viewer.currentBend;
+            Snapshot(gid);
+            return;
+        }
+
+        if (!Mathf.Approximately(viewer.currentBend, lastBend))
+        {
+            int inGroup = 0;
+            int weighted = 0;
+            int overridden = 0;
+            foreach (HairCard card in FindObjectsByType<HairCard>(FindObjectsSortMode.None))
+            {
+                if (card == null || card.groupId != gid) continue;
+                inGroup++;
+                if (card.selectionWeight > 0f) weighted++;
+                if (card.HasExternalClumpOverride()) overridden++;
+            }
+
+            int postCount = 0;
+            if (posts != null)
+            {
+                List<PostAffectorSaveData> items = posts.ExportGroup(gid);
+                if (items != null) postCount = items.Count;
+            }
+
+            Debug.Log(string.Format(
+                "[GROOMDIAG] BEND {0:F2} -> {1:F2} | group={2} cards={3} weighted={4} override={5} " +
+                "| hotspot={6} selMode={7} relMode={8} | posts={9} activeClumper={10}",
+                lastBend, viewer.currentBend, gid, inGroup, weighted, overridden,
+                Flag(hasSelField), Flag(selModeField), Flag(relModeField),
+                postCount, GroupClumperManager.HasActiveClumper(gid)));
+
+            lastBend = viewer.currentBend;
+            reportFrames = 3;
+            return;
+        }
+
+        if (reportFrames <= 0) return;
+        reportFrames--;
+
+        int changedBend = 0;
+        int changedSig = 0;
+        int stillOverridden = 0;
+        float sampleBefore = 0f;
+        float sampleAfter = 0f;
+        bool haveSample = false;
+
+        foreach (HairCard card in FindObjectsByType<HairCard>(FindObjectsSortMode.None))
+        {
+            if (card == null || card.groupId != gid) continue;
+            int id = card.GetInstanceID();
+
+            float wasBend;
+            if (cardBend.TryGetValue(id, out wasBend) && !Mathf.Approximately(wasBend, card.bendAngle))
+            {
+                changedBend++;
+                if (!haveSample)
+                {
+                    sampleBefore = wasBend;
+                    sampleAfter = card.bendAngle;
+                    haveSample = true;
+                }
+            }
+
+            int wasSig;
+            if (cardSig.TryGetValue(id, out wasSig) && wasSig != card.GetGeneratedMeshSignature()) changedSig++;
+            if (card.HasExternalClumpOverride()) stillOverridden++;
+        }
+
+        Debug.Log(string.Format(
+            "[GROOMDIAG]   +{0}f  cardsBendChanged={1} meshSigChanged={2} stillOverridden={3}{4}",
+            3 - reportFrames, changedBend, changedSig, stillOverridden,
+            haveSample ? string.Format("  sample {0:F2}->{1:F2}", sampleBefore, sampleAfter) : ""));
+
+        if (reportFrames == 0) Snapshot(gid);
+    }
+}
